rules_version = '2';

// Ajar — Firestore security rules.
//
// These are not deployed by the app. Paste them into the Firebase console
// (Firestore Database -> Rules -> Publish). They live in the repo so the
// rules are reviewable and versioned alongside the code they protect,
// instead of existing only as console state nobody can diff.
//
// The model
// ---------
// Everything a school owns lives under schools/{schoolId}/. A teacher's
// own document names the one school they may write to, so a teacher at one
// school cannot publish into another's classroom even by editing the
// request — the check happens here, not in the app.
//
// Students stay anonymous. They never create an account, never type a
// password, and can only append their own practice attempts. Only a
// teacher — signed in to an account that belongs to the APP rather than to
// the person, and listed under /teachers — can write anything students
// will read. That is the one guarantee the whole product rests on, and it
// used to be enforced by the UI hiding a button rather than by anything
// underneath.
//
// Two limits, stated rather than hidden
// -------------------------------------
// 1. A student is identified by the name they type, not by an account, so
//    these rules cannot stop one student writing attempts under another
//    student's name, or reading another student's history WITHIN their own
//    school. Closing that needs per-student accounts, which costs more
//    than it buys for a class of 13 who share a room with their teacher.
//
// 2. Because students are anonymous, the schoolId in a share link is what
//    separates one school's material from another's for READING. It is
//    therefore a long random string rather than a guessable name, and
//    should be treated as a password that happens to live in a URL.
//    WRITING is not subject to that limitation: it requires a teacher
//    account tied to that exact school.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function teacherDoc() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // A teacher may write only into the school named in their own
    // document. This is the whole of multi-tenancy: one comparison, made
    // by the database, that no client can influence.
    function isTeacherOf(schoolId) {
      return isTeacher() && teacherDoc().schoolId == schoolId;
    }

    // The teacher roster. Created by hand in the console; the app never
    // writes here, so no client can promote itself or move schools.
    match /teachers/{uid} {
      // Her own document, and only hers.
      //
      // This used to be "any signed-in user", which sounds narrow and is
      // not: students never sign in, so the app signs EVERY visitor in
      // anonymously, and anonymous satisfies isSignedIn(). A teacher's
      // name and school were therefore readable by anyone who opened the
      // address — which mattered the moment we started asking her for a
      // full name to show her class.
      //
      // Nothing breaks by closing it. The app only ever fetches the
      // signed-in user's own record (loadTeacherRecord(uid) with that
      // user's uid); it never lists the collection. And isTeacherOf()
      // below reads this path with get(), which runs server-side and is
      // not subject to these client read rules.
      allow read: if isSignedIn() && request.auth.uid == uid;

      // Her display name and the name of her school, and nothing else.
      //
      // Both are shown to her class, so she should be able to fix them
      // without asking anyone — a teacher's name is hers, and getting it
      // wrong in front of her students is not a thing to need permission
      // for.
      //
      // schoolName lives HERE, on her own private record, rather than on
      // schools/{schoolId} — that document is readable by any signed-in
      // visitor, and every visitor is signed in anonymously, so putting it
      // there would publish it. The requirement was that this shows on her
      // screen and therefore on the classroom TV, without teacher data
      // being publicly readable. Those two are only compatible if it is
      // stored on the record that only she can read.
      //
      // schoolId is still untouchable: it decides which classroom she can
      // publish to, and an account able to edit its own would move itself
      // into another school. hasOnly() is what draws that line, and it is
      // drawn here rather than in the form, because the form enforces
      // nothing.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'schoolName'])
        && (!('name' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 80))
        && (!('schoolName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.schoolName is string
                && request.resource.data.schoolName.size() > 0
                && request.resource.data.schoolName.size() <= 120));

      // Creating or deleting a teacher stays a console job. Self-signup
      // would let anyone with an account become a teacher of any school.
      allow create, delete: if false;
    }

    match /schools/{schoolId} {

      // The school document itself holds only a display name. Nothing
      // reads it yet; it exists so a school is a real record rather than a
      // string that happens to appear in paths.
      allow read: if isSignedIn();
      allow write: if false;

      // Everything the class receives: the whole-class batch
      // (classroom/current) and one document per shared exercise
      // (classroom/item_*). Any signed-in visitor holding the school id may
      // read — that is how a QR code works without an account. Only that
      // school's teacher may write.
      match /classroom/{docId} {
        allow read: if isSignedIn();
        allow write: if isTeacherOf(schoolId);
      }

      // A student's practice history, scoped to their school.
      match /students/{studentId} {

        function validStudent() {
          // 'summary' is the compact per-student record the teacher's
          // class panel reads — five numbers, no raw history. Without it
          // here every write from a practising student is refused, which
          // is how this file and the console drifted apart once already.
          return request.resource.data.keys().hasOnly(['displayName', 'lastSeen', 'summary'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60;
        }

        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && studentId.size() <= 60
          && validStudent();
        // History is a record of what happened. Nothing in the app deletes
        // a student, so nothing should be able to.
        allow delete: if false;

        match /attempts/{attemptId} {

          // Shape of one logged attempt, exactly as logUsage() builds it:
          // { type, theme, outcome, ts }. Anything else is not something
          // this app produces, so it is not something the database accepts.
          function validAttempt() {
            return request.resource.data.keys().hasOnly(['type', 'theme', 'outcome', 'ts'])
              && request.resource.data.type is string
              && request.resource.data.type.size() <= 40
              && request.resource.data.theme is string
              && request.resource.data.theme.size() <= 40
              && request.resource.data.outcome is number
              && request.resource.data.outcome >= 0
              && request.resource.data.outcome <= 1
              && request.resource.data.ts is number;
          }

          allow read: if isSignedIn();
          allow create: if isSignedIn() && validAttempt();
          // An attempt is a fact about the past. Editing or deleting one
          // would let a student rewrite the history their teacher reads.
          allow update, delete: if false;
        }
      }
    }

    // Anything not named above does not exist as far as clients are
    // concerned. Without this, a collection added later in the console
    // would silently inherit no protection at all. It also means the
    // pre-multi-tenancy /classroom and /students collections, if data is
    // still sitting in them, are now unreachable rather than exposed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
